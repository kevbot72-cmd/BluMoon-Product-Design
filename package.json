{
	"name": "blumoon-product-studio",
	"private": true,
	"type": "module",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "vite build",
		"release": "tools/release.sh",
		"dev": "vite",
		"schema": "node packages/editor-core/src/schema/generate.ts",
		"schema:check": "node packages/editor-core/src/schema/generate.ts && git diff --exit-code -- schema/json",
		"typecheck": "tsc -b",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"packages/**/*.css\"",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"@wordpress/env": "^12.0.0",
		"es-module-lexer": "^3.0.4",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"rolldown": "^1.2.15",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
